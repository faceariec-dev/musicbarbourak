---
// Běžící pás s hlavními informacemi (místo prázdného předělu).
interface Props { items: string[] }
const { items } = Astro.props;
const row = [...items, ...items];
---
<div class="ticker" aria-label={items.join(', ')}>
  <div class="ticker__track" aria-hidden="true">
    {row.map((t) => <span class="ticker__item">{t}</span>)}
  </div>
</div>
