---
import { site, tel, downloads } from '../data/site';
import { jidlo } from '../data/napoje';
import { url } from '../data/url';
const home = url();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src={url('images/logo-bourak.png')} alt="Music Bar Bourák" width="180" height="43" loading="lazy" />
        <p>{site.name} – {site.claim}. Těšíme se na vás!</p>
        <div class="footer-social">
          <a href={site.facebook} aria-label="Music Bar Bourák na Facebooku" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg></a>
          <a href={site.instagram} aria-label="Music Bar Bourák na Instagramu" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg></a>
        </div>
      </div>

      <div>
        <div class="footer-col-title">Rychlé odkazy</div>
        <div class="footer-links">
          <a href={`${home}#napoje`}>Bar</a>
          <a href={`${home}#program`}>Program</a>
          <a href={`${home}#kviz`}>Chytrý kvíz</a>
          <a href={`${home}#akce-na-miru`}>Oslavy a firemní akce</a>
          <a href={`${home}#kontakt`}>Kontakt</a>
        </div>
      </div>

      <div>
        <div class="footer-col-title">Lístky a rezervace</div>
        <div class="footer-links">
          <a href={url('napojovy-listek/')}>Nápojový lístek</a>
          {jidlo.length > 0 && <a href={url('napojovy-listek/#jidlo')}>Jídelní lístek</a>}
          <a href={url('specialni-drinky/')}>Koktejlový lístek</a>
          {downloads.map((d) => <a href={url(d.file)}>{d.title} (PDF)</a>)}
          <a href={`${home}#rezervace`}>Rezervace</a>
        </div>
      </div>

      <div>
        <div class="footer-col-title">Ozvěte se</div>
        <div class="footer-links">
          <a href={tel(site.phone)}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.name}. Všechna práva vyhrazena.</span>
      <span>Webdesign by StudioWeb</span>
    </div>
  </div>
</footer>
