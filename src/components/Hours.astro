---
import { hours } from '../data/site';
const fmt = (open: [string, string][]) =>
  open.length ? open.map(([a, b]) => `${a.replace(/^0/, '')} – ${b.replace(/^0/, '')}`).join(', ') : 'zavřeno';
---
<div class="hours-list">
  {hours.map((h, i) => (
    <div class="hours-list__row" data-day={(i + 1) % 7}>
      <span>{h.day}</span><span>{fmt(h.open)}</span>
    </div>
  ))}
</div>
