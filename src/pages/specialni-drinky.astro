---
import { Image, getImage } from 'astro:assets';
import barImg from '../assets/bar-atmosphere.webp';
import '@fontsource/montserrat/900.css';
import Base from '../layouts/Base.astro';
import { signature, drinky, kategorie } from '../data/specialni-drinky';
import { kc } from '../data/napoje';
import { url } from '../data/url';
const home = url();
const bg = await getImage({ src: barImg, width: 900 });

const doporucene = drinky.filter((d) => d.doporucujeme && d.img);
const skupiny = kategorie
  .map((k) => ({ ...k, items: drinky.filter((d) => d.kategorie === k.id) }))
  .filter((k) => k.items.length);
---
<Base
  title="Koktejlový lístek – Music Bar Bourák | Praha 4 – Háje"
  description="Koktejlový lístek Music Bar Bourák: Bouráček, naše vlastní drinky, klasiky, long drinky, shoty i nealko. Vyber si, co ti dneska nabourá večer."
  bodyClass="drinks-page"
>
  <div class="drinks-photo-bg" aria-hidden="true" style={`--photo-bg:url(${bg.src})`}></div>

  <header class="drinks-nav">
    <div class="container drinks-nav__inner">
      <a class="drinks-nav__logo" href={home} aria-label="Music Bar Bourák – domů">
        <img src={url('images/logo-bourak.png')} alt="Music Bar Bourák" width="180" height="43" />
      </a>
      <a href={`${home}#napoje`} class="drinks-nav__back">← Zpět na web</a>
    </div>
  </header>

  <main id="main">
    <section class="drinks-hero" aria-label="Koktejlový lístek">
      <div class="container">
        <p class="drinks-hero__eyebrow">Music Bar Bourák</p>
        <h1 class="drinks-hero__title">Koktejlový lístek</h1>
        <p class="drinks-hero__subtitle">Vyber si, co ti dneska nabourá večer.</p>
      </div>
    </section>

    <section class="drinks-grid-section" aria-label="Bouráček a doporučené drinky">
      <div class="container">
        <div class="drinks-grid">
          <article class="drink-card drink-card--featured reveal">
            <div class="drink-card__photo">
              <Image src={signature.img} alt={signature.name} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 50vw" />
            </div>
            <div class="drink-card__body">
              <p class="drink-card__tagline">{signature.tagline}</p>
              <h2 class="drink-card__name drink-card__name--featured">{signature.name.toUpperCase()}</h2>
              <span class="drink-card__rule" aria-hidden="true"></span>
              <p class="drink-card__price">{kc(signature.price)}</p>
            </div>
            <figure class="drink-card__real">
              <Image src={signature.foto} alt="Tác Bouráčků na baru" widths={[200, 400]} sizes="180px" />
              <figcaption>Ideálně po tácech</figcaption>
            </figure>
          </article>
        </div>

        {doporucene.length > 0 && (
          <>
            <h2 class="koktejly-nadpis">Doporučujeme</h2>
            <div class="doporucene">
              {doporucene.map((d) => (
                <article class={`drink-card drink-card--tile drink-card--tone-${d.tone ?? 'brown'} reveal`}>
                  <div class="drink-card__photo">
                    <Image src={d.img!} alt={d.name} widths={[300, 600]} sizes="(max-width: 700px) 100vw, 33vw" />
                  </div>
                  <div class="drink-card__body">
                    <div class="drink-badges">
                      {d.novinka && <span class="drink-badge drink-badge--new">Novinka</span>}
                      {d.sezonni && <span class="drink-badge">Sezónní</span>}
                    </div>
                    <h3 class="drink-card__name">{d.name.toUpperCase()}</h3>
                    <span class="drink-card__rule" aria-hidden="true"></span>
                    <p class="drink-card__ingr-line">{d.ingredients.join(' · ')}</p>
                    {d.price && <p class="drink-card__price">{kc(d.price)}</p>}
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    <nav class="koktejly-chips" aria-label="Kategorie koktejlů">
      <div class="container koktejly-chips__inner">
        {skupiny.map((k) => <a href={`#${k.id}`}>{k.title} <span>{k.items.length}</span></a>)}
      </div>
    </nav>

    <section class="koktejly" aria-label="Celý koktejlový lístek">
      <div class="container">
        {skupiny.map((k) => (
          <section class="koktejly-skupina" id={k.id} aria-labelledby={`h-${k.id}`}>
            <header class="koktejly-skupina__head">
              <h2 id={`h-${k.id}`}>{k.title}</h2>
              <p>{k.desc}</p>
            </header>
            <ul class="koktejly-list">
              {k.items.map((d) => (
                <li class={`koktejl ${d.img ? 'koktejl--foto' : ''} drink-card--tone-${d.tone ?? 'brown'}`}>
                  {d.img && (
                    <div class="koktejl__thumb">
                      <Image src={d.img} alt="" widths={[120, 240]} sizes="80px" />
                    </div>
                  )}
                  <div class="koktejl__text">
                    <h3 class="koktejl__name">
                      {d.name}
                      {d.novinka && <span class="drink-badge drink-badge--new">Novinka</span>}
                      {d.sezonni && <span class="drink-badge">Sezónní</span>}
                    </h3>
                    <p class="koktejl__ingr">{d.ingredients.join(' · ')}</p>
                  </div>
                  <span class="koktejl__price">{d.price ? kc(d.price) : ''}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
        <p class="koktejly-foot">Ceny jsou uvedeny v Kč.</p>
      </div>
    </section>

    <section class="drinks-cta" aria-label="Rezervace">
      <div class="container">
        <h2 class="drinks-cta__title">Dneska to nabouráme.</h2>
        <a href={`${home}#rezervace`} class="btn btn--primary"><span aria-hidden="true">📅</span> Rezervovat stůl</a>
      </div>
    </section>
  </main>

  <footer class="drinks-footer">
    <div class="container drinks-footer__inner">
      <span>© {new Date().getFullYear()} Music Bar Bourák</span>
      <a href={home}>← Zpět na hlavní web</a>
    </div>
  </footer>
</Base>
